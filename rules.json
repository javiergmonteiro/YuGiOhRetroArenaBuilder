{
  "_groups": {
    "exodia": [
      "Exodia the Forbidden One",
      "Left Arm of the Forbidden One",
      "Right Arm of the Forbidden One",
      "Left Leg of the Forbidden One",
      "Right Leg of the Forbidden One"
    ],
    "hand_draw": [
      "Magical Library", "Upstart Goblin", "Toon World", "Spell Economics", "Good Goblin Housekeeping",
      "Dekoichi the Battlechanted Locomotive"
    ],
    "toon": [
      "Toon World", "Toon Summoned Skull", "Toon Gemini Elf", "Toon Goblin Attack Force", "Toon Gemini Elf", "Manga Ryu-Ran",
      "Blue-Eyes Toon Dragon", "Toon Mermaid"
    ],
    "control": [
      "Soul Exchange", "Enemy Controller", "Change of Heart", "Snatch Steal"
    ],
    "discard": [
      "Card Destruction", "Graceful Charity", "Raigeki Break", "Phoenix Wing Wind Blast"
    ],
    "gravekeepers": [
      "Gravekeeper's Spy", "Necrovalley", "Gravekeeper's Guard", "Gravekeeper's Assailant",
      "Gravekeeper's Spear Soldier", "Gravekeeper's Chief"
    ],
    "agro": [
      "Final Attack Orders", "Goblin Attack Force", "Giant Orc", "Berserk Gorilla", "Gigantes", "Spear Dragon",
      "Skill Drain", "Zombyra the Dark"
    ],
    "zombies": [
      "Pyramid Turtle", "Spirit Reaper", "Ryu Kokki", "Creature Swap", "Vampire Lord", "Book of Life", "Giant Rat", "Mystic Tomato"
    ],
    "tribute_monsters": [
      "Jinzo", "Mobius the Frost Monarch", "Thestalos the Firestorm Monarch", "Brain Control", "Snatch Steal", "Soul Exchange",
      "Zaborg the Thunder Monarch", "Raiza the Storm Monarch", "Caius the Shadow Monarch", "Granmarg the Rock Monarch"
    ],
    "recruiters": [
      "Gravekeeper's Spy", "Shining Angel", "Pyramid Turtle", "Mystic Tomato",
      "Giant Rat", "Mother Grizzly", "Sangan", "Witch of the Black Forest", "Thunder Dragon"
    ],
    "nephthys": [
      "Hand of Nephthys", "Sacred Phoenix of Nephthys"
    ]
  },

  "_rarity": { "lim": 0.1, "semi": 0.30, "mulL": 0.2, "mulS": 0.5 },

  "_pop": { "gamma": 0.5 },
  "_fresh": 0.7,

  "_ensure": [
    { "group": "exodia" }
  ],

  "Magical Library": {
    "shift": { "spell": 6, "monster": -6 },
    "when": [ { "has": ["@exodia"], "x": 4 } ]
  },

  "Card Destruction": { "when": [ { "has": ["@exodia", "Magical Library"], "x": 4 } ] },

  "Pot of Greed":     { "when": [ { "has": ["@exodia", "Magical Library"], "x": 2 } ] },

  "Royal Decree": {
    "shift": { "trap": -4, "monster": 2, "spell": 2 },
    "when": [ { "trap": "<=5", "x": 4 }, { "trap": ">=9", "x": 0.1 } ]
  },

  "Jinzo": {
    "when": [ { "trap": "<=6", "x": 2 }, { "trap": ">=12", "x": 0.3 } ]
  },

  "Cursed Seal of the Forbidden Spell": {
    "when": [ { "spell": "<=6", "x": 3 }, { "spell": ">=14", "x": 0.2 } ]
  },

  "Monster Gate": { "shift": { "monster": 6, "spell": -6 } },

  "Gravity Bind": { "shift": { "trap": 3, "monster": -3 } },

  "Sinister Serpent": { "when": [ { "has": ["@discard"], "x": 3 } ] },

  "Thunder Dragon": {"when":  [{ "has": ["@discard"], "x": 3 }, { "has": ["@exodia"], "x": 3 } ] },

  "@tribute_monsters": { "when": [ { "has": ["@control"], "x": 3 } ] },

  "@exodia": {
    "shift": { "spell": 1, "monster": -1 },
    "when": [ { "has": ["@exodia", "Magical Library"], "x": 6 } ]
  },

  "@recruiters": {
    "when": [ { "copies": ">=1", "x": 2 }, { "copies": ">=2", "x": 1 } ]
  },

  "#race:Beast": { "when": [ { "has": ["Rescue Cat"], "x": 2 } ] },
  "#race:Beast,lv<=3": { "when": [ { "has": ["Rescue Cat"], "x": 3 } ] },

  "@discard": { "when": [ { "has": ["Sinister Serpent"], "x": 3 } ] },

  "@gravekeepers": { "when": [ { "has": ["@gravekeepers"], "x": 3 } ] },

  "@zombies": { "when": [ { "has": ["@zombies"], "x": 3 } ] },

  "@toon": { "when": [ { "has": ["@toon"], "x": 3 }, { "has": ["Toon World"], "x": 3 } ] },

  "@agro": { "when":  [{"has":  ["Final Attack Orders"], "x": 2 }, {"has": ["@agro"], "x": 2 } ] }
}
